rules_version = '2';

// Regras do Firestore: cada pessoa só enxerga e escreve o que é dela.
// Publicar com: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    match /usuarios/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // O app pode criar e editar o próprio perfil, menos o campo admin:
      // quem dá acesso de ADM é o console do Firebase, nunca o aplicativo.
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && !('admin' in request.resource.data);

      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && (!('admin' in request.resource.data)
                        || request.resource.data.admin == resource.data.admin);

      // Apagar a própria conta é um direito, não um favor: sem isto, o botão de
      // apagar nas configurações deixaria o perfil órfão na nuvem.
      allow delete: if request.auth != null && request.auth.uid == uid;

      // Lembretes e exercícios criados pelo usuário (próxima etapa).
      match /{colecao}/{documento} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Quantas contas já foram criadas, para dar o número do jogador na abertura.
    // Qualquer pessoa logada pode ler e somar um; não pode escolher o valor
    // e não pode acrescentar outros campos.
    //
    // Diminuir um só é permitido a quem tem o último número, e só na mesma
    // transação que apaga o próprio perfil: é a conta apagada devolvendo o
    // número para o próximo cadastro. Ninguém consegue baixar o contador e
    // continuar com o número na mão.
    match /contadores/jogadores {
      function devolveUltimoNumero() {
        let perfil = /databases/$(database)/documents/usuarios/$(request.auth.uid);
        return request.resource.data.total == resource.data.total - 1
               && exists(perfil)
               && get(perfil).data.get('numeroJogador', 0) == resource.data.total
               && !existsAfter(perfil);
      }

      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['total'])
                    && request.resource.data.total == 1;

      allow update: if request.auth != null
                    && request.resource.data.keys().hasOnly(['total'])
                    && (request.resource.data.total == resource.data.total + 1
                        || devolveUltimoNumero());

      allow delete: if false;
    }
  }
}
